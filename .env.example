# Copy this file to ".env" and adjust the values.

# Port the server listens on
PORT=3000

# Secret used to sign login sessions (change this to any long random string).
# If you leave it empty, a random secret is generated and stored in data/.secret
# (which means sessions reset if that file is deleted).
JWT_SECRET=

# How long a login session stays valid.
SESSION_TTL=30d
